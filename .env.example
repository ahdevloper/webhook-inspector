APP_NAME="Webhook Inspector"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_REPLAY_TIMEOUT=10
WEBHOOK_RATE_LIMIT=120

GEO_SEARCH_CACHE_SECONDS=300
GEO_NEARBY_MAX_RADIUS_KM=200
